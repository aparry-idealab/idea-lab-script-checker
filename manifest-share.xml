<?xml version="1.0" encoding="UTF-8"?>
<!--
  This is the PRODUCTION / SHAREABLE manifest. Unlike manifest.xml (which
  points at https://localhost:3000 for local development), this one points
  at the GitHub Pages-hosted copy of the add-in, so colleagues can sideload
  it without running any local dev server or trusting a self-signed
  certificate.

  To share this add-in with a colleague:
    1. Send them this file (manifest-share.xml) - e.g. via email/Teams/drive.
    2. In Word (desktop or Word Online), use "Upload My Add-in" (Home tab ->
       Add-ins -> Upload My Add-in / Get more apps) and select this file.
    3. They do NOT need Node.js, npm, or this repository at all - the
       add-in's HTML/CSS/JS is served live from GitHub Pages.

  Whenever ruleEngine.js / taskpane.* changes, push to the `main` branch and
  GitHub Pages will redeploy automatically within a minute or two.
-->
<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
    xsi:type="TaskPaneApp">

  <Id>7d9f2a3c-5e1b-4f6a-9c2d-8a1b3e4f5a6c</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>IDEA Lab, Imperial College Business School</ProviderName>
  <DefaultLocale>en-GB</DefaultLocale>
  <DisplayName DefaultValue="IDEA Lab Script Checker" />
  <Description DefaultValue="A last-hurdle, read-only quick check of video scripts for obvious errors, read-aloud flow, bullet points, house style and inclusive language, before they go into production." />
  <IconUrl DefaultValue="https://aparry-idealab.github.io/idea-lab-script-checker/assets/icon-64.png" />
  <HighResIconUrl DefaultValue="https://aparry-idealab.github.io/idea-lab-script-checker/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://aparry-idealab.github.io/idea-lab-script-checker/" />

  <AppDomains>
    <AppDomain>https://aparry-idealab.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://aparry-idealab.github.io/idea-lab-script-checker/src/taskpane/taskpane.html" />
  </DefaultSettings>

  <!-- Read-only by design: this add-in never writes to the document. -->
  <Permissions>ReadDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <FunctionFile resid="Taskpane.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="ScriptChecker.Group">
                <Label resid="ScriptChecker.GroupLabel" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="ScriptChecker.TaskpaneButton">
                  <Label resid="ScriptChecker.TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="ScriptChecker.TaskpaneButton.Label" />
                    <Description resid="ScriptChecker.TaskpaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://aparry-idealab.github.io/idea-lab-script-checker/assets/icon-32.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://aparry-idealab.github.io/idea-lab-script-checker/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://aparry-idealab.github.io/idea-lab-script-checker/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://aparry-idealab.github.io/idea-lab-script-checker/" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://aparry-idealab.github.io/idea-lab-script-checker/src/taskpane/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="IDEA Lab Script Checker is ready" />
        <bt:String id="ScriptChecker.GroupLabel" DefaultValue="Script Checker" />
        <bt:String id="ScriptChecker.TaskpaneButton.Label" DefaultValue="Check Script" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Click the 'Check Script' button to run a quick, read-only check of this script before production." />
        <bt:String id="ScriptChecker.TaskpaneButton.Tooltip" DefaultValue="Run a last-hurdle quick check for obvious errors, read-aloud flow, bullet points, house style and inclusive language. Read-only - this never edits your document automatically." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
